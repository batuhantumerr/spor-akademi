# Copy to .env and replace the values: cp .env.example .env
# .env is ignored by Git; never commit real secrets (NFR-SEC-09).
#
# Passwords must contain only letters and digits. Generate each one with: openssl rand -hex 24
# The values are read as plain data and placed into connection strings, where characters such as
# ; or quotes would change the meaning. Check your .env with: scripts/ef.sh --check-env

# PostgreSQL superuser, used only for setup and maintenance; the application never connects with it.
POSTGRES_SUPERUSER_PASSWORD=changemesuperuser

# Owns the database and runs migrations (NFR-SEC-10).
SPOR_AKADEMI_MIGRATOR_PASSWORD=changememigrator

# Used by the API at runtime; cannot change the schema (NFR-SEC-10).
SPOR_AKADEMI_APP_PASSWORD=changemeapp

# Seq admin password (user name: admin), applied on first start only.
SEQ_ADMIN_PASSWORD=changemeseq

# Host port for PostgreSQL; change it if 5432 is already in use on your machine.
POSTGRES_HOST_PORT=5432
