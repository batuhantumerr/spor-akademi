<Project>

  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Code quality: warnings fail the build (NFR-MNT-01). -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Vulnerable packages (NFR-SEC-11, DEC-080). Every restore audits direct and transitive packages. Under
       TreatWarningsAsErrors, high (NU1903) and critical (NU1904) findings fail the build, and so does NU1900
       (the vulnerability data could not be read: "could not check" must not pass as "checked, clean").
       Low (NU1901) and moderate (NU1902) findings stay visible as warnings without failing the build.
       An advisory that cannot be fixed yet is excepted only with a NuGetAuditSuppress item for its URL,
       with the owner's approval, the reason and a review date (DEC-080). -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Lock files (P0-38, DEC-080): every project's packages.lock.json records the exact version and content
       hash of each direct and transitive package. A local restore updates them; CI and the image build
       restore with an explicit locked-mode flag, which fails instead of resolving anything that differs. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- The migrator image builds a self-contained linux-x64 migration bundle from the src projects (ADR-0011).
       Restoring them for linux-x64 as well puts that runtime's graph into their lock files, so the bundle is
       built under locked mode too. The .NET runtime packs the bundle embeds are not recorded in lock files;
       NuGet's signature verification covers them instead (DEC-093). Test projects are not bundled. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').StartsWith('src'))">
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
