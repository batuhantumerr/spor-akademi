# Code style rules for the whole repository.
# Rules set to `warning` fail the build because of TreatWarningsAsErrors and EnforceCodeStyleInBuild
# (Directory.Build.props). Line endings are handled by .gitattributes.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

# Angular apps (Angular style guide). Prettier reads these settings too.
[web/**/*.{ts,js,html,css}]
indent_size = 2

[web/**/*.ts]
quote_type = single

[*.cs]

#### Language rules ####

# One namespace per file, declared without braces.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# `using` directives at the top of the file, System namespaces first.
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Always use braces, even for single-line `if` bodies.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# `var` is preferred; it is a suggestion, not enforced.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Use `int`, `string` instead of `Int32`, `String`.
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_diagnostic.IDE0049.severity = warning

# No `this.` qualifier.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0003.severity = warning

# Explicit accessibility modifiers on every member.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning

# Formatting (indentation, spacing, new lines) is checked in the build as well as by `dotnet format`.
dotnet_diagnostic.IDE0055.severity = warning

#### Code quality rules ####

# Classes are sealed by default (CONTRIBUTING.md §5, ADR-0004). CA1852 flags internal types that are never
# inherited from. The SDK has no built-in rule for public types.
dotnet_diagnostic.CA1852.severity = warning

#### Naming rules ####

# Symbol groups
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, method, property, event
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_symbols.non_private_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local

# Styles
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_style.i_prefix.required_prefix = I

dotnet_naming_style.t_prefix.capitalization = pascal_case
dotnet_naming_style.t_prefix.required_prefix = T

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Rules: interfaces `IStudentReader`, type parameters `TResult`, types and members `PascalCase`,
# constants `PascalCase`, non-private fields `PascalCase`, private fields `_camelCase`, parameters and locals `camelCase`.
dotnet_naming_rule.interfaces_rule.symbols = interfaces
dotnet_naming_rule.interfaces_rule.style = i_prefix
dotnet_naming_rule.interfaces_rule.severity = warning

dotnet_naming_rule.type_parameters_rule.symbols = type_parameters
dotnet_naming_rule.type_parameters_rule.style = t_prefix
dotnet_naming_rule.type_parameters_rule.severity = warning

dotnet_naming_rule.types_and_members_rule.symbols = types_and_members
dotnet_naming_rule.types_and_members_rule.style = pascal_case
dotnet_naming_rule.types_and_members_rule.severity = warning

dotnet_naming_rule.constants_rule.symbols = constants
dotnet_naming_rule.constants_rule.style = pascal_case
dotnet_naming_rule.constants_rule.severity = warning

dotnet_naming_rule.non_private_fields_rule.symbols = non_private_fields
dotnet_naming_rule.non_private_fields_rule.style = pascal_case
dotnet_naming_rule.non_private_fields_rule.severity = warning

dotnet_naming_rule.private_fields_rule.symbols = private_fields
dotnet_naming_rule.private_fields_rule.style = underscore_camel_case
dotnet_naming_rule.private_fields_rule.severity = warning

dotnet_naming_rule.parameters_and_locals_rule.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_rule.style = camel_case
dotnet_naming_rule.parameters_and_locals_rule.severity = warning

dotnet_diagnostic.IDE1006.severity = warning

# Test projects only. Nothing is disabled under src/ (DEC-074).
[tests/**/*.cs]

# CA1707 forbids underscores in member names. Test names describe behaviour as
# `Method_WhenCondition_ExpectedResult` (ADR-0008, "İsimlendirme davranışı anlatır").
dotnet_diagnostic.CA1707.severity = none

# CA1515 asks for public types in executables to be internal. xUnit v3 test projects are executables, and xUnit
# discovers only public test classes (xUnit documentation: test classes must be public).
dotnet_diagnostic.CA1515.severity = none
